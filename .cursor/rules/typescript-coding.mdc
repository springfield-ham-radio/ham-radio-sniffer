### Function Examples

#### Single Responsibility

```typescript
// Good - each function has a single responsibility
function validateUserInput(userData: CreateUserData): ValidationResult {
  const errors: string[] = [];

  if (!userData.name?.trim()) {
    errors.push('Name is required');
  }

  if (!isValidEmail(userData.email)) {
    errors.push('Valid email is required');
  }

  if (userData.age && (userData.age < 0 || userData.age > 120)) {
    errors.push('Age must be between 0 and 120');
  }

  return {
    isValid: errors.length === 0,
    errors,
  };
}

function sanitizeUserData(userData: CreateUserData): SanitizedUserData {
  return {
    name: userData.name.trim(),
    email: userData.email.toLowerCase().trim(),
    age: userData.age || null,
  };
}

function createUser(userData: CreateUserData): User {
  const validation = validateUserInput(userData);

  if (!validation.isValid) {
    throw new Error(`Validation failed: ${validation.errors.join(', ')}`);
  }

  const sanitizedData = sanitizeUserData(userData);

  return {
    id: generateUserId(),
    ...sanitizedData,
    createdAt: new Date(),
  };
}
```

#### Error Handling with Loglayer

```typescript
// Good - comprehensive error handling with loglayer
async function processUserRegistration(userData: CreateUserData): Promise<User> {
  try {
    logger.withMetadata({ email: userData.email }).info('Starting user registration');

    // Validate input
    const validation = validateUserInput(userData);

    if (!validation.isValid) {
      logger
        .withMetadata({
          email: userData.email,
          errors: validation.errors,
        })
        .warn('User registration validation failed');

      throw new Error(`Validation failed: ${validation.errors.join(', ')}`);
    }

    // Check if user already exists
    const existingUser = await findUserByEmail(userData.email);

    if (existingUser) {
      logger.withMetadata({ email: userData.email }).warn('User registration attempted with existing email');
      throw new Error('User with this email already exists');
    }

    // Create user
    const user = await createUser(userData);

    // Send welcome email
    await sendWelcomeEmail(user.email);

    logger
      .withMetadata({
        userId: user.id,
        email: user.email,
      })
      .info('User registration completed successfully');

    return user;
  } catch (error) {
    logger.withError(error).error('User registration failed');
    logger.withMetadata({ email: userData.email }).error('User registration failed');

    throw error;
  }
}
```

## Examples

### Complete Function Example

```typescript
/**
 * Processes user authentication and returns user session information.
 *
 * This function handles the complete authentication flow including token
 * validation, user lookup, and session creation. It implements our
 * security requirements for multi-factor authentication and session
 * management.
 *
 * @param credentials - User login credentials
 * @param credentials.email - User's email address
 * @param credentials.password - User's password
 * @param credentials.totpCode - Two-factor authentication code (optional)
 *
 * @returns Promise resolving to user session information
 *
 * @throws {AuthenticationError} When credentials are invalid
 * @throws {MFARequiredError} When MFA is required but not provided
 * @throws {AccountLockedError} When account is locked due to failed attempts
 */
async function authenticateUser(credentials: LoginCredentials): Promise<UserSession> {
  try {
    logger.withMetadata({ email: credentials.email }).info('User authentication started');

    // Validate input
    if (!credentials.email || !credentials.password) {
      throw new Error('Email and password are required');
    }

    // Find user by email
    const user = await findUserByEmail(credentials.email);

    if (!user) {
      logger.withMetadata({ email: credentials.email }).warn('Authentication failed - user not found');
      throw new Error('Invalid credentials');
    }

    // Check if account is locked
    if (user.isLocked) {
      logger.withMetadata({ userId: user.id }).warn('Authentication failed - account locked');
      throw new Error('Account is locked. Please contact support.');
    }

    // Verify password
    const isPasswordValid = await verifyPassword(credentials.password, user.passwordHash);

    if (!isPasswordValid) {
      await recordFailedLogin(user.id);
      logger.withMetadata({ userId: user.id }).warn('Authentication failed - invalid password');
      throw new Error('Invalid credentials');
    }

    // Check MFA requirement
    if (user.mfaEnabled && !credentials.totpCode) {
      logger.withMetadata({ userId: user.id }).info('MFA required for authentication');
      throw new Error('Two-factor authentication code required');
    }

    // Verify MFA if provided
    if (user.mfaEnabled && credentials.totpCode) {
      const isMFAValid = await verifyTOTP(credentials.totpCode, user.mfaSecret);

      if (!isMFAValid) {
        logger.withMetadata({ userId: user.id }).warn('Authentication failed - invalid MFA code');
        throw new Error('Invalid two-factor authentication code');
      }
    }

    // Create session
    const session = await createUserSession(user.id);

    // Reset failed login attempts
    await resetFailedLogins(user.id);

    logger
      .withMetadata({
        userId: user.id,
        sessionId: session.id,
      })
      .info('User authentication completed successfully');

    return session;
  } catch (error) {
    logger.withError(error).error('User authentication failed');
    logger.withMetadata({ email: credentials.email }).error('User authentication failed');

    throw error;
  }
}
```

### Class Example

```typescript
/**
 * Manages user authentication and session handling.
 *
 * This class provides a centralized interface for all authentication-related
 * operations including login, logout, session management, and security
 * features like rate limiting and account locking.
 */
class AuthenticationService {
  readonly baseUrl: string;
  readonly sessionTimeout: number;

  constructor(baseUrl: string, sessionTimeout: number = 3600) {
    this.baseUrl = baseUrl;
    this.sessionTimeout = sessionTimeout;
  }

  /**
   * Authenticates a user and creates a new session.
   *
   * @param credentials - User login credentials
   * @returns Promise resolving to user session
   */
  async login(credentials: LoginCredentials): Promise<UserSession> {
    return authenticateUser(credentials);
  }

  /**
   * Logs out a user and invalidates their session.
   *
   * @param sessionId - The session ID to invalidate
   */
  async logout(sessionId: string): Promise<void> {
    try {
      await invalidateSession(sessionId);
      logger.withMetadata({ sessionId }).info('User logged out successfully');
    } catch (error) {
      logger.withError(error).error('Logout failed');
      logger.withMetadata({ sessionId }).error('Logout failed');
      throw new Error('Failed to logout user');
    }
  }

  /**
   * Validates a session and returns user information.
   *
   * @param sessionId - The session ID to validate
   * @returns Promise resolving to user information if session is valid
   */
  async validateSession(sessionId: string): Promise<UserInfo | null> {
    try {
      const session = await getSession(sessionId);

      if (!session || session.isExpired) {
        return null;
      }

      return await getUserById(session.userId);
    } catch (error) {
      logger.withError(error).error('Session validation failed');
      logger.withMetadata({ sessionId }).error('Session validation failed');
      return null;
    }
  }
}
```
