{
  "name": "@springfield/ham-radio-sniffer",
  "version": "0.1.0",
  "author": "Bryan Hunt",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Headless serial sniffer for ham radio clone protocols",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/springfield-ham-radio/ham-radio-sniffer.git"
  },
  "scripts": {
    "build": "nuxt build",
    "commitlint": "commitlint --edit",
    "dev": "nuxt dev",
    "format": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --fix-suggestions",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "preview": "nuxt preview",
    "sniff": "tsx src/cli.ts",
    "start": "HOST=\"${HOST:-127.0.0.1}\" PORT=\"${PORT:-3010}\" node .output/server/index.mjs",
    "test": "yarn test:unit",
    "test:unit": "tsx --test test/unit/**/*.test.ts"
  },
  "dependencies": {
    "@serialport/parser-byte-length": "^13.0.0",
    "@springfield/ham-radio-driver": "^3.3.5",
    "@springfield/ham-radio-utils": "^4.12.3",
    "loglayer": "^9.4.0",
    "nuxt": "^4.3.0",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/chai": "5.2.3",
    "@types/node": "26.5.1",
    "chai": "6.2.2",
    "husky": "9.1.7",
    "oxfmt": "^0.67.0",
    "oxlint": "1.82.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "packageManager": "yarn@4.18.0"
}
